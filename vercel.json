{
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "installCommand": "pip install -r requirements.txt",
      "buildCommand": "python -m alembic upgrade head"
    },
    "uploads": {
      "root": "node_api",
      "framework": "express",
      "installCommand": "npm ci",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "GEOLABEL_BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/blob-upload",
      "destination": {
        "service": "uploads"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
