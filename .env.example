# Required in every environment
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME
FIREBASE_PROJECT_ID=your-firebase-project-id

# Required for admin operations unless Firebase custom admin claims are used
GEOLABEL_ADMIN_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-geolabel-origin.example
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Local tests/dev only; never use SQLite in production
# APP_ENV=test
# DATABASE_URL=sqlite:///./geolabel-test.db
