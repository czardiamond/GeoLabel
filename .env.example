# Backend API settings. Never commit a real service key.
# Generate a strong secret (at least 32 characters) with: openssl rand -hex 32
GEOLABEL_API_KEY=
DATABASE_URL=sqlite:///./geolabel.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Private local asset storage. Mount durable, access-controlled storage in deployed environments.
ASSET_STORAGE_DIR=./geolabel-assets
MAX_ASSET_UPLOAD_MB=512
USER_SESSION_HOURS=12

# Optional remote HTTPS imagery import. Exact hostnames only; empty disables remote downloads.
# Redirects are not followed. S3/Google Cloud credentialed connectors are not configured here.
IMAGERY_ALLOWED_HOSTS=

# Optional outbound task-completion callbacks: exact hostnames, comma-separated.
# Webhook URLs must use HTTPS and match an entry here. Empty disables callbacks.
WEBHOOK_ALLOWED_HOSTS=

# Frontend setting (place in the frontend root's .env.local when needed).
VITE_GEOLABEL_API_URL=http://localhost:8000
